# AgentVerdict OS - example environment file.
# Contains ONLY public configuration and safe placeholders. Never commit a
# real private key, wallet seed, or LLM provider key to this repo or to
# any .env file tracked by git (.gitignore already excludes .env and
# .env.*, keeping only this .example file).

# --- Network (public, matches docs/GENLAYER_CAPABILITY_MATRIX.md) ---
GENLAYER_NETWORK=studionet
GENLAYER_CHAIN_ID=61999
GENLAYER_RPC_URL=https://studio.genlayer.com/api

# --- Frontend (Stage 4, not yet built in this repo) ---
# Pinned exactly per the build brief; do not use a floating range.
GENLAYER_JS_VERSION=1.1.8

# --- Local integration testing only (tests/integration/) ---
# Set these yourself in your own shell / local .env, never in this file.
# Used only by gltest.config.yaml's testnet_bradbury entry if you choose to
# run integration tests against a funded testnet account you control.
# ACCOUNT_PRIVATE_KEY_1=0x_your_own_testnet_bradbury_private_key_never_mainnet

# Used only if you run a local GLSim/Studio instance with a real LLM
# provider for integration testing (see docs/DEPLOYMENT_RUNBOOK.md section 8
# and docs/FINAL_HANDOFF.md for why this project's own session had neither
# configured). Never set a production/live key here.
# OPENAI_API_KEY=sk-your-own-test-key-never-committed
